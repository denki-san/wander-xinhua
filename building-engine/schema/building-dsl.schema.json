{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wander-xinhua.local/schema/building-dsl-v1.json",
  "title": "Wander Xinhua Building DSL v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "archetype",
    "artProfile",
    "evidence",
    "coordinateContract",
    "materials",
    "massing",
    "master",
    "collision",
    "runtime",
    "budgets",
    "unknowns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "archetype": {
      "const": "garden-villa"
    },
    "artProfile": {
      "const": "xinhua-autumn-lowpoly-v1"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["casePath", "claimIds"],
      "properties": {
        "casePath": {
          "type": "string"
        },
        "claimIds": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coordinateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sceneUnitMeters", "front", "groundDatum"],
      "properties": {
        "sceneUnitMeters": {
          "const": 2.7
        },
        "front": {
          "const": "local-negative-y"
        },
        "groundDatum": {
          "const": 0
        }
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string"
      }
    },
    "massing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumes", "roofs"],
      "properties": {
        "volumes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/volume"
          }
        },
        "roofs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/roof"
          }
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openings", "features"],
      "properties": {
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opening"
          }
        },
        "features": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/feature"
          }
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obstacles", "requiredOpenPaths"],
      "properties": {
        "obstacles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/obstacle"
          }
        },
        "requiredOpenPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/openPath"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandboxScale", "cameras"],
      "properties": {
        "sandboxScale": {
          "const": 1
        },
        "cameras": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical", "side", "entrance"],
          "properties": {
            "canonical": {
              "$ref": "#/$defs/camera"
            },
            "side": {
              "$ref": "#/$defs/camera"
            },
            "entrance": {
              "$ref": "#/$defs/camera"
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["massing", "master"],
      "properties": {
        "massing": {
          "$ref": "#/$defs/budget"
        },
        "master": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "strategy"],
        "properties": {
          "field": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "vector2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "claimRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "volume": {
      "type": "object",
      "required": ["id", "type", "center", "height", "material", "evidenceClaimIds"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["box", "cylinder"]
        },
        "center": {
          "$ref": "#/$defs/vector2"
        },
        "size": {
          "$ref": "#/$defs/vector2"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "segments": {
          "type": "integer",
          "minimum": 8,
          "maximum": 32
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "baseHeight": {
          "type": "number",
          "minimum": 0
        },
        "material": {
          "type": "string"
        },
        "lowerMaterial": {
          "type": "string"
        },
        "lowerHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "evidenceClaimIds": {
          "$ref": "#/$defs/claimRefs"
        }
      }
    },
    "roof": {
      "type": "object",
      "required": ["id", "type", "center", "eaveHeight", "ridgeHeight", "material", "evidenceClaimIds"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["gable", "hipped", "flat"]
        },
        "shape": {
          "enum": ["rect", "round"]
        },
        "center": {
          "$ref": "#/$defs/vector2"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "span": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "topRadius": {
          "type": "number",
          "minimum": 0
        },
        "segments": {
          "type": "integer",
          "minimum": 8,
          "maximum": 32
        },
        "ridgeAxis": {
          "enum": ["X", "Y"]
        },
        "ridgeLength": {
          "type": "number",
          "minimum": 0
        },
        "eaveHeight": {
          "type": "number",
          "minimum": 0
        },
        "ridgeHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "material": {
          "type": "string"
        },
        "gableMaterial": {
          "type": "string"
        },
        "evidenceClaimIds": {
          "$ref": "#/$defs/claimRefs"
        }
      }
    },
    "opening": {
      "type": "object",
      "required": ["id", "type", "anchor", "width", "height", "material", "evidenceClaimIds"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": ["rect-window", "arched-opening", "window-row"]
        },
        "anchor": {
          "$ref": "#/$defs/vector3"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "spacing": {
          "type": "number",
          "minimum": 0
        },
        "rotationDegrees": {
          "type": "number"
        },
        "outsideSign": {
          "enum": [-1, 1]
        },
        "pointed": {
          "type": "boolean"
        },
        "open": {
          "type": "boolean"
        },
        "material": {
          "type": "string"
        },
        "trimMaterial": {
          "type": "string"
        },
        "frameMaterial": {
          "type": "string"
        },
        "evidenceClaimIds": {
          "$ref": "#/$defs/claimRefs"
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["id", "type", "evidenceClaimIds"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "timber-gable",
            "balcony",
            "round-tower",
            "chimney",
            "porte-cochere",
            "trim-band"
          ]
        },
        "anchor": {
          "$ref": "#/$defs/vector3"
        },
        "center": {
          "$ref": "#/$defs/vector2"
        },
        "size": {
          "$ref": "#/$defs/vector3"
        },
        "span": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "eaveHeight": {
          "type": "number",
          "minimum": 0
        },
        "ridgeHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotationDegrees": {
          "type": "number"
        },
        "material": {
          "type": "string"
        },
        "roofMaterial": {
          "type": "string"
        },
        "trimMaterial": {
          "type": "string"
        },
        "frameMaterial": {
          "type": "string"
        },
        "columns": {
          "type": "array"
        },
        "windowAnglesDegrees": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "evidenceClaimIds": {
          "$ref": "#/$defs/claimRefs"
        }
      }
    },
    "obstacle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minX", "maxX", "minY", "maxY"],
      "properties": {
        "id": {
          "type": "string"
        },
        "minX": {
          "type": "number"
        },
        "maxX": {
          "type": "number"
        },
        "minY": {
          "type": "number"
        },
        "maxY": {
          "type": "number"
        }
      }
    },
    "openPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "width"],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/vector2"
        },
        "to": {
          "$ref": "#/$defs/vector2"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "orthoScale"],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "target": {
          "$ref": "#/$defs/vector3"
        },
        "orthoScale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxNodes", "maxTriangles", "maxMaterials", "maxImages", "maxBytes"],
      "properties": {
        "maxNodes": {
          "type": "integer",
          "minimum": 1
        },
        "maxTriangles": {
          "type": "integer",
          "minimum": 1
        },
        "maxMaterials": {
          "type": "integer",
          "minimum": 1
        },
        "maxImages": {
          "const": 0
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
