{
  "name": "wander-xinhua",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run build:static && npm run build:sites",
    "build:static": "vite build --config vite.static.config.ts",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "check:binary-policy": "node scripts/check_repository_binary_policy.mjs",
    "baseline:binary": "node scripts/check_repository_binary_policy.mjs --write-baseline",
    "preview:static": "vite preview --config vite.static.config.ts",
    "start": "npm run preview:static",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "height:poc:evidence": "node scripts/generate_building_height_evidence.mjs --scope poc",
    "height:poc:review": "node scripts/apply_building_height_poc_review.mjs",
    "height:poc:build": "node scripts/generate_overview_district_massing.mjs --raw docs/research/data/xinhua-buildings-osm-20260725-074802.json --height-mode poc --activate-poc",
    "height:poc:gate": "node scripts/evaluate_building_height_poc.mjs",
    "height:full:evidence": "node scripts/generate_building_height_evidence.mjs --scope full",
    "height:full:build": "node scripts/generate_overview_district_massing.mjs --raw docs/research/data/xinhua-buildings-osm-20260725-074802.json --height-mode full",
    "height:round2:build": "node scripts/generate_overview_district_massing.mjs --raw docs/research/data/xinhua-buildings-osm-20260725-074802.json --height-mode round2 --height-evidence app/scene/xinhua-building-height-runtime.json --activate-round2",
    "building:fast": "node scripts/run_building_fast_mode.mjs",
    "test": "npm run check:binary-policy && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "postprocessing": "^6.39.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "polygon-clipping": "^0.15.7",
    "react-server-dom-webpack": "19.2.6",
    "shapefile": "^0.6.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.14"
  },
  "type": "module"
}
